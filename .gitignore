# Keep only the WordPress theme from the backend.
/*
!/backend/
!/backend/app/
/backend/app/*
!/backend/app/public/
/backend/app/public/*
!/backend/app/public/wp-content/
/backend/app/public/wp-content/*
/backend/app/public/wp-content/themes/*
!/backend/app/public/wp-content/themes/
!/backend/app/public/wp-content/themes/baharhussain/
!/backend/app/public/wp-content/themes/baharhussain/**

# Keep the Next.js frontend.
!/frontend/
!/frontend/**

# Dependencies and generated packages.
**/node_modules/
**/.pnp/
**/.pnp.*
**/.yarn/
**/vendor/
**/.next/
**/out/
**/coverage/
**/dist/
**/.cache/
**/.parcel-cache/

# Local configuration and secrets.
**/.env
**/.env.*
!**/.env.example
**/*.local

# Logs, databases, and local runtime files.
**/logs/
**/*.log
**/*.sql
**/.htaccess
**/.DS_Store
**/Thumbs.db
**/.history/
**/.idea/
**/.vscode/
**/*.tsbuildinfo
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# Backend runtime content outside the tracked theme.
/backend/app/public/wp-content/uploads/
/backend/app/public/wp-content/plugins/
/backend/app/public/wp-admin/
/backend/app/public/wp-includes/
/backend/cms/
/backend/conf/
